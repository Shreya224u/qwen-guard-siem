# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/siem_db

# Redis 
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Neo4j (added in Phase 7)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this

# Email verification and password reset email (SMTP)
# Example: Gmail uses smtp.gmail.com, port 587, TLS enabled.
# SMTP_USERNAME is the sending mailbox; SMTP_PASSWORD is its SMTP/app password.
# Set SMTP_FROM to an address this mailbox is allowed to send as.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Mobile verification (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Local-only fallback: API returns the code to the login UI when delivery is not configured.
# Keep false outside local development.
AUTH_OTP_DEV_MODE=false

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/github/callback
FRONTEND_URL=http://127.0.0.1:5173
